Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^(private|app|tests|docs|scripts|DOCUMENTATION|backups|database-backups|logs)(/|$) - [F,L]
</IfModule>

<FilesMatch "(?i)^(?:\.env(?:\..*)?|config\.php|\.git.*|\.cursor.*|\.editorconfig|.*\.(?:sql|bak|log|key|zip)|.*\.php\.txt)$">
Require all denied
</FilesMatch>
