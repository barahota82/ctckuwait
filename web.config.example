<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="private" />
          <add segment="private" />
          <remove segment="app" />
          <add segment="app" />
          <remove segment="tests" />
          <add segment="tests" />
          <remove segment="docs" />
          <add segment="docs" />
          <remove segment=".env.php" />
          <add segment=".env.php" />
          <remove segment=".env.tmp.php" />
          <add segment=".env.tmp.php" />
          <remove segment=".env.example.php" />
          <add segment=".env.example.php" />
          <remove segment="config.php" />
          <add segment="config.php" />
          <remove segment=".git" />
          <add segment=".git" />
          <remove segment=".gitignore" />
          <add segment=".gitignore" />
          <remove segment=".gitattributes" />
          <add segment=".gitattributes" />
          <remove segment=".cursorignore" />
          <add segment=".cursorignore" />
          <remove segment=".cursorindexingignore" />
          <add segment=".cursorindexingignore" />
          <remove segment=".editorconfig" />
          <add segment=".editorconfig" />
          <remove segment="scripts" />
          <add segment="scripts" />
          <remove segment="DOCUMENTATION" />
          <add segment="DOCUMENTATION" />
          <remove segment="backups" />
          <add segment="backups" />
          <remove segment="database-backups" />
          <add segment="database-backups" />
          <remove segment="logs" />
          <add segment="logs" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="20000000" />
        <denyUrlSequences>
          <remove sequence=".env" />
          <add sequence=".env" />
          <remove sequence=".php.txt" />
          <add sequence=".php.txt" />
        </denyUrlSequences>
        <fileExtensions>
          <remove fileExtension=".sql" />
          <add fileExtension=".sql" allowed="false" />
          <remove fileExtension=".bak" />
          <add fileExtension=".bak" allowed="false" />
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
          <remove fileExtension=".key" />
          <add fileExtension=".key" allowed="false" />
          <remove fileExtension=".zip" />
          <add fileExtension=".zip" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" errorMode="DetailedLocalOnly" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="same-origin" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>